{
  "version": 2,
  "builds": [
    {
      "src": "api/chat-ia.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/bienvenida.html"
    },
    {
      "src": "/api/chat-ia",
      "dest": "/api/chat-ia.js"
    }
  ]
}